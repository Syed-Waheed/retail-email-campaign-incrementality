      <column caption='Spend Lift ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_6029301739581443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [segment] : AVG([spend]) }&#10;-&#10;{ FIXED : AVG(&#10;    IF [segment] = &quot;No E-Mail&quot; THEN [spend] END&#10;) }' />
      </column>
      <column caption='Segment Conversion Lift (pp)' datatype='real' name='[Calculation_6029301744398340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    { FIXED [history_segment], [segment] : AVG([conversion]) }&#10;    -&#10;    { FIXED [history_segment] :&#10;        AVG(&#10;            IF [segment] = &quot;No E-Mail&quot;&#10;            THEN [conversion]&#10;            END&#10;        )&#10;    }&#10;) * 100' />
