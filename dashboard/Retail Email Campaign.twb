      <column caption='KPI - Womens Spend Lift ($)' datatype='real' default-format='n&quot;+&quot;#,##0.000&quot;$&quot;;-&quot;+&quot;#,##0.000&quot;$&quot;' name='[Calculation_6029301750652940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(&#10;    IF [segment] = &quot;Womens E-Mail&quot;&#10;    THEN [spend]&#10;    END&#10;) }&#10;-&#10;{ FIXED : AVG(&#10;    IF [segment] = &quot;No E-Mail&quot;&#10;    THEN [spend]&#10;    END&#10;) }' />
