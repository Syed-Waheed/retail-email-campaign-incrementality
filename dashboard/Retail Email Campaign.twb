      <column caption='Scenario Incremental Profit ($)' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_6029301752430607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([segment]) = &quot;Mens E-Mail&quot; THEN&#10;    MIN(&#10;        { FIXED : SUM(&#10;            IF [segment] = &quot;Mens E-Mail&quot; THEN 1 ELSE 0 END&#10;        ) }&#10;    )&#10;    *&#10;    (&#10;        MIN([Calculation_6029301750489099]) * [Parameters].[Parameter 6029301752217614]&#10;        - [Parameters].[Parameter 6029301751894029]&#10;    )&#10;&#10;ELSEIF ATTR([segment]) = &quot;Womens E-Mail&quot; THEN&#10;    MIN(&#10;        { FIXED : SUM(&#10;            IF [segment] = &quot;Womens E-Mail&quot; THEN 1 ELSE 0 END&#10;        ) }&#10;    )&#10;    *&#10;    (&#10;        MIN([Calculation_6029301750652940]) * [Parameters].[Parameter 6029301752217614]&#10;        - [Parameters].[Parameter 6029301751894029]&#10;    )&#10;END' />
