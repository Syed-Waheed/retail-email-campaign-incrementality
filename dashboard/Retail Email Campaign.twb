      <column caption='KPI - Total Customers' datatype='integer' name='[Calculation_6029301749100550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([segment])' />
      </column>
      <column caption='KPI - Mens Conversion Lift (pp)' datatype='real' default-format='n&quot;+&quot;#,##0.000;-&quot;+&quot;#,##0.000' name='[Calculation_6029301749989385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    { FIXED : AVG(&#10;        IF [segment] = &quot;Mens E-Mail&quot;&#10;        THEN [conversion]&#10;        END&#10;    ) }&#10;    -&#10;    { FIXED : AVG(&#10;        IF [segment] = &quot;No E-Mail&quot;&#10;        THEN [conversion]&#10;        END&#10;    ) }&#10;) * 100' />
