      <aliases enabled='yes' />
      <column caption='Conversion Lift (pp)' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_6029301736321024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    { FIXED [segment] : AVG([conversion]) }&#10;    -&#10;    { FIXED : AVG(&#10;        IF [segment] = &quot;No E-Mail&quot; THEN [conversion] END&#10;    ) }&#10;) * 100' />
