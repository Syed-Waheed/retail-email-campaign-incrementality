        <calculation class='tableau' formula='(&#10;    { FIXED : AVG(&#10;        IF [segment] = &quot;Womens E-Mail&quot;&#10;        THEN [conversion]&#10;        END&#10;    ) }&#10;    -&#10;    { FIXED : AVG(&#10;        IF [segment] = &quot;No E-Mail&quot;&#10;        THEN [conversion]&#10;        END&#10;    ) }&#10;) * 100' />
